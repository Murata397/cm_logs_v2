<% content_for :title, "マイページ | CM Logs" %>

<section class="p-mypage-profile">
  <div class="l-container p-mypage-profile__inner">
    <div class="p-mypage-profile__avatar">
      <% if @user.profile_image.attached? %>
        <%= image_tag @user.profile_image, alt: "" %>
      <% else %>
        <span aria-hidden="true"><%= @user.name.first %></span>
      <% end %>
    </div>
    <div class="p-mypage-profile__body">
      <h1 class="p-mypage-profile__name"><%= @user.name %></h1>
      <p class="p-mypage-profile__intro"><%= @user.introduction.presence || "自己紹介はまだありません" %></p>
      <dl class="p-mypage-profile__stats">
        <div><dt>整備記録</dt><dd><%= @user.maintenances.visible.count %></dd></div>
        <div><dt>マイカー</dt><dd><%= @cars.size %></dd></div>
      </dl>
      <div class="p-mypage-profile__actions">
        <% if can_post? %>
          <%= link_to "プロフィールを編集", edit_profile_path, class: "c-button c-button--outline" %>
          <%= link_to "アカウント設定", edit_user_registration_path, class: "c-button c-button--outline" %>
        <% end %>
        <%= link_to "公開ページを見る", user_path(@user), class: "c-button c-button--outline" %>
      </div>
    </div>
  </div>
</section>

<div class="l-container p-mypage">
  <section class="p-mypage__section">
    <div class="p-mypage__head">
      <h2 class="p-mypage__title">これからの点検</h2>
      <%= link_to "マイカーで管理 →", cars_path, class: "p-mypage__more" %>
    </div>

    <% if @upcoming.any? %>
      <ul class="p-mypage__schedules">
        <% @upcoming.each do |schedule| %>
          <li class="p-mypage__schedule">
            <div>
              <p class="p-mypage__schedule-item"><%= schedule.item %></p>
              <p class="p-mypage__schedule-car"><%= schedule.car.car_name %></p>
            </div>
            <div class="p-mypage__schedule-left">
              <% if schedule.days_left %>
                <span class="c-badge <%= 'c-badge--notice' if schedule.days_left <= 14 %>">あと<%= schedule.days_left %>日</span>
              <% end %>
              <% if schedule.km_left %>
                <span class="c-badge <%= 'c-badge--notice' if schedule.km_left <= 500 %>">あと<%= number_with_delimiter(schedule.km_left) %>km</span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="p-mypage__empty">点検の予定はまだありません。マイカーから登録できます。</p>
    <% end %>
  </section>

  <section class="p-mypage__section">
    <h2 class="p-mypage__title">燃費の記録</h2>

    <% cars_with_logs = @cars.select { |car| car.fuel_logs.any? } %>
    <% if cars_with_logs.any? %>
      <% cars_with_logs.each do |car| %>
        <article class="p-mypage__fuel">
          <div class="p-mypage__fuel-head">
            <h3 class="p-mypage__fuel-name"><%= car.car_name %></h3>
            <div class="p-mypage__fuel-links">
              <%= link_to "履歴・編集", car_fuel_logs_path(car), class: "p-mypage__more" %>
              <% if can_post? %>
                <%= link_to "＋ 給油を記録", new_car_fuel_log_path(car), class: "p-mypage__more" %>
              <% end %>
            </div>
          </div>
          <dl class="p-mypage__fuel-stats">
            <div><dt>平均燃費</dt><dd><%= car.average_efficiency %> km/L</dd></div>
            <div><dt>最新の燃費</dt><dd><%= car.latest_fuel_log.efficiency %> km/L</dd></div>
            <div><dt>記録した回数</dt><dd><%= car.fuel_logs.size %>回</dd></div>
          </dl>
          <%= render "fuel_chart", car: car, logs: car.recent_fuel_logs %>
        </article>
      <% end %>
    <% else %>
      <p class="p-mypage__empty">給油の記録はまだありません。マイカーから記録できます。</p>
    <% end %>
  </section>

  <section class="p-mypage__section">
    <div class="p-mypage__head">
      <h2 class="p-mypage__title">自分の整備記録</h2>
      <% if can_post? %>
        <%= link_to "＋ 記録を投稿", new_maintenance_path, class: "p-mypage__more" %>
      <% end %>
    </div>

    <% if @maintenances.any? %>
      <ul class="p-mypage__posts">
        <% @maintenances.each do |m| %>
          <li class="p-mypage__post">
            <div>
              <% if m.draft? %><span class="c-badge">下書き</span><% end %>
              <%= link_to m.title, m.published? ? maintenance_path(m) : edit_maintenance_path(m), class: "p-mypage__post-title" %>
              <p class="p-mypage__post-sub"><%= l m.maintenance_day %> ／ <%= m.car.car_name %></p>
            </div>
            <%= link_to "編集", edit_maintenance_path(m), class: "c-button c-button--outline" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="p-mypage__empty">まだ整備記録を投稿していません。</p>
    <% end %>
  </section>

  <section class="p-mypage__section">
    <div class="p-mypage__head">
      <h2 class="p-mypage__title">お気に入り</h2>
      <%= link_to "すべて見る →", favorites_path, class: "p-mypage__more" %>
    </div>
    <% if @favorites.any? %>
      <ul class="p-mypage__posts">
        <% @favorites.each do |m| %>
          <li class="p-mypage__post">
            <div>
              <%= link_to m.title, maintenance_path(m), class: "p-mypage__post-title" %>
              <p class="p-mypage__post-sub"><%= m.category %> ／ <%= m.car.car_name %></p>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="p-mypage__empty">お気に入りした整備記録はまだありません。</p>
    <% end %>
  </section>
  <section class="p-mypage__section">
    <div class="p-mypage__head">
      <h2 class="p-mypage__title">参加しているグループ</h2>
      <%= link_to "グループを探す →", groups_path, class: "p-mypage__more" %>
    </div>
    <% if @groups.any? %>
      <ul class="p-mypage__posts">
        <% @groups.each do |group| %>
          <li class="p-mypage__post">
            <div>
              <%= link_to group.name, group_path(group), class: "p-mypage__post-title" %>
              <p class="p-mypage__post-sub"><%= group.owned_by?(@user) ? "オーナー" : "メンバー" %><%= " ／ #{group.theme}" if group.theme.present? %></p>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="p-mypage__empty">参加しているグループはまだありません。</p>
    <% end %>
  </section>
</div>
