<% content_for :title, "プロフィールを編集 | CM Logs" %>

<section class="p-form-page">
  <div class="p-form-page__card">
    <h1 class="p-form-page__title">プロフィールを編集</h1>

    <%= form_with model: @user, url: profile_path, method: :patch, class: "c-form" do |f| %>
      <%= render "shared/errors", model: @user %>

      <div class="c-form__field">
        <%= f.label :name, class: "c-form__label" %>
        <%= f.text_field :name, class: "c-form__input" %>
      </div>

      <div class="c-form__field">
        <%= f.label :introduction, class: "c-form__label" %>
        <%= f.text_area :introduction, rows: 4, placeholder: "乗っている車や、よくやる整備など", class: "c-form__input c-form__textarea" %>
        <p class="c-form__hint">300文字まで</p>
      </div>

      <div class="c-form__field">
        <%= f.label :profile_image, class: "c-form__label" %>
        <%= f.file_field :profile_image, accept: "image/jpeg,image/png,image/webp,image/gif", class: "c-form__file" %>
      </div>

      <%= f.submit "保存する", class: "c-button c-button--primary c-button--block" %>
    <% end %>

    <p class="p-form-page__note">
      メールアドレス・パスワードの変更や退会は<%= link_to "アカウント設定", edit_user_registration_path %>から
    </p>
  </div>
</section>
