<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "管理画面 | CM Logs" %></title>
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# 画面がチカッと白くならないように、最初にテーマを決める %>
    <script>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        var isDark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = isDark ? "dark" : "light";
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="p-admin">
    <header class="p-admin__header">
      <div class="p-admin__header-inner">
        <%= link_to (admin_signed_in? ? admin_root_path : new_admin_session_path), class: "p-admin__brand" do %>
          CM Logs <span>管理画面</span>
        <% end %>
        <% if admin_signed_in? %>
          <nav class="p-admin__nav" aria-label="管理メニュー">
            <%= link_to "ダッシュボード", admin_root_path, class: ("is-current" if controller_name == "dashboards") %>
            <%= link_to "ユーザー", admin_users_path, class: ("is-current" if controller_name == "users") %>
            <%= link_to "整備記録", admin_maintenances_path, class: ("is-current" if controller_name == "maintenances") %>
            <%= link_to "グループ", admin_groups_path, class: ("is-current" if controller_name == "groups") %>
            <%= link_to "コメント", admin_comments_path, class: ("is-current" if controller_name == "comments") %>
          </nav>
          <div class="p-admin__account">
            <%= link_to "サイトを見る", root_path, target: "_blank", rel: "noopener" %>
            <%= button_to "ログアウト", destroy_admin_session_path, method: :delete, class: "c-button c-button--outline" %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="p-admin__main">
      <% flash.each do |type, message| %>
        <p class="c-flash"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
