<%= form_with model: car, class: "c-form" do |f| %>
  <%= render "shared/errors", model: car %>

  <div class="c-form__field">
    <%= f.label :car_name, class: "c-form__label" %>
    <%= f.text_field :car_name, placeholder: "例：プリウス", class: "c-form__input" %>
  </div>

  <div class="c-form__field">
    <%= f.label :manufacturer_name, class: "c-form__label" %>
    <%= f.text_field :manufacturer_name, placeholder: "例：トヨタ", class: "c-form__input" %>
  </div>

  <div class="c-form__field">
    <%= f.label :car_model, class: "c-form__label" %>
    <%= f.text_field :car_model, placeholder: "例：ZVW30", class: "c-form__input" %>
    <p class="c-form__hint">車検証の「型式」欄に書いてあります。同じ型式の整備記録を探すのに使います</p>
  </div>

  <div class="c-form__field">
    <%= f.label :odometer, class: "c-form__label" %>
    <%= f.number_field :odometer, min: 0, inputmode: "numeric", class: "c-form__input" %>
  </div>

  <div class="c-form__field">
    <%= f.label :purpose, class: "c-form__label" %>
    <%= f.text_field :purpose, placeholder: "例：通勤・レジャー", class: "c-form__input" %>
  </div>

  <div class="c-form__field">
    <%= f.label :image, class: "c-form__label" %>
    <%= f.file_field :image, accept: "image/*", class: "c-form__file" %>
  </div>

  <%= f.submit class: "c-button c-button--primary c-button--block" %>
<% end %>