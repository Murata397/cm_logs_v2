<% content_for :title, "マイカー | CM Logs" %>

<section class="l-container p-cars">
  <header class="p-cars__head">
    <h1 class="p-cars__title">マイカー</h1>
    <%= link_to "＋ 車を登録", new_car_path, class: "c-button c-button--primary" %>
  </header>

  <% if @cars.any? %>
    <ul class="p-cars__list">
      <% @cars.each do |car| %>
        <li class="p-cars__item">
          <div class="p-cars__image">
            <% if car.image.attached? %>
              <%= image_tag car.image, alt: car.car_name, loading: "lazy" %>
            <% else %>
              <span class="p-cars__no-image">NO IMAGE</span>
            <% end %>
          </div>
          <div class="p-cars__body">
            <h2 class="p-cars__name"><%= link_to car.car_name, car_path(car) %></h2>
            <p class="p-cars__spec"><%= car.manufacturer_name %> ／ <%= car.car_model %></p>
            <% if car.odometer.present? %>
              <p class="p-cars__spec">走行距離 <%= number_with_delimiter(car.odometer) %> km</p>
            <% end %>

            <% if (inspection = car.next_inspection) %>
              <div class="p-cars__next">
                <p class="p-cars__next-label">次の点検</p>
                <p class="p-cars__next-item">
                  <%= inspection.item %>
                  <span class="c-badge <%= 'c-badge--notice' if inspection.days_left <= 14 %>">あと<%= inspection.days_left %>日</span>
                </p>
                <p class="p-cars__next-date"><%= l inspection.next_due_on %> 予定</p>
                <%= link_to "編集", edit_car_inspection_schedule_path(car, inspection), class: "p-cars__next-edit" %>
              </div>
            <% end %>

            <% if (fuel = car.latest_fuel_log) %>
              <p class="p-cars__spec">最新の燃費 <strong><%= fuel.efficiency %> km/L</strong>（<%= l fuel.refueled_on %>）</p>
            <% end %>

            <div class="p-cars__links">
              <%= link_to "＋ 点検の予定", new_car_inspection_schedule_path(car) %>
              <%= link_to "＋ 給油を記録", new_car_fuel_log_path(car) %>
              <% if car.fuel_logs.any? %>
                <%= link_to "給油の履歴", car_fuel_logs_path(car) %>
              <% end %>
            </div>
            <div class="p-cars__actions">
              <%= link_to "編集", edit_car_path(car), class: "c-button c-button--outline" %>
              <%= button_to "削除", car_path(car), method: :delete,
                    class: "c-button c-button--outline",
                    form: { data: { turbo_confirm: "#{car.car_name}を削除しますか？この車の整備記録も削除されます。" } } %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="p-cars__empty">まだ車が登録されていません。まずは1台登録してみましょう。</p>
  <% end %>
</section>