<div id="<%= dom_id(maintenance, :favorite) %>" class="c-favorite">
  <% if can_post? %>
    <% favorited = maintenance.favorited_by?(current_user) %>
    <%= button_to maintenance_favorite_path(maintenance),
          method: (favorited ? :delete : :post),
          class: "c-favorite__button #{'is-active' if favorited}",
          aria: { pressed: favorited } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 20s-7-4.4-9.2-8.6C1.1 8.1 3.2 4.5 6.8 4.5c2 0 3.4 1 5.2 3 1.8-2 3.2-3 5.2-3 3.6 0 5.7 3.6 4 6.9C19 15.6 12 20 12 20z"/>
      </svg>
      <span><%= favorited ? "お気に入り済み" : "お気に入り" %></span>
    <% end %>
  <% end %>
  <span class="c-favorite__count"><%= maintenance.favorites_count %>人がお気に入り</span>
</div>
