<%= form_with model: [car, schedule], class: "c-form" do |f| %>
  <%= render "shared/errors", model: schedule %>

  <div class="c-form__field">
    <%= f.label :item, class: "c-form__label" %>
    <%= f.text_field :item, placeholder: "例：オイル交換、車検、タイヤ交換", class: "c-form__input" %>
  </div>

  <div class="c-form__row">
    <div class="c-form__field">
      <%= f.label :next_due_on, class: "c-form__label" %>
      <%= f.date_field :next_due_on, class: "c-form__input" %>
    </div>
    <div class="c-form__field">
      <%= f.label :next_due_odometer, class: "c-form__label" %>
      <%= f.number_field :next_due_odometer, min: 0, inputmode: "numeric", class: "c-form__input" %>
    </div>
  </div>
  <p class="c-form__hint">日付か走行距離の、どちらか片方だけでもOKです</p>

  <%= f.submit class: "c-button c-button--primary c-button--block" %>
<% end %>
