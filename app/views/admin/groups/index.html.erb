<% content_for :title, "グループ | 管理画面" %>

<h1 class="p-admin__title">グループ</h1>
<%= render "admin/shared/toolbar", kept_label: "表示中", deleted_label: "削除済み", placeholder: "グループ名" %>

<div class="p-admin__table-wrap">
  <table class="p-admin__table">
    <thead>
      <tr><th scope="col">ID</th><th scope="col">グループ名</th><th scope="col">オーナー</th><th scope="col">作成日</th><th scope="col"><span class="u-visually-hidden">操作</span></th></tr>
    </thead>
    <tbody>
      <% @records.each do |g| %>
        <tr>
          <td><%= g.id %></td>
          <th scope="row">
            <% if g.deleted? %><%= g.name %><% else %><%= link_to g.name, group_path(g), target: "_blank", rel: "noopener" %><% end %>
          </th>
          <td><%= link_to g.owner.name, admin_user_path(g.owner) %></td>
          <td><%= l g.created_at.to_date %></td>
          <td class="p-admin__actions">
            <%= render "admin/shared/row_actions", record: g, delete_label: "削除",
                  delete_path: admin_group_path(g), restore_path: restore_admin_group_path(g),
                  confirm: "「#{g.name}」を削除しますか？（あとで復元できます）" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @records.empty? %><p class="p-admin__empty">該当するグループはありません。</p><% end %>
</div>
