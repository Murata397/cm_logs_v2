<% content_for :title, "管理者ログイン | CM Logs" %>

<section class="p-form-page">
  <div class="p-form-page__card">
    <h1 class="p-form-page__title">管理者ログイン</h1>

    <%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "c-form" do |f| %>
      <div class="c-form__field">
        <%= f.label :email, class: "c-form__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "c-form__input" %>
      </div>

      <div class="c-form__field">
        <%= f.label :password, class: "c-form__label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "c-form__input" %>
      </div>

      <%= f.submit "ログイン", class: "c-button c-button--primary c-button--block" %>
    <% end %>
  </div>
</section>
