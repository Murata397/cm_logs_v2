<% content_for :title, "お知らせを送る | CM Logs" %>

<section class="p-form-page">
  <div class="p-form-page__card">
    <h1 class="p-form-page__title">お知らせを送る</h1>
    <p class="p-form-page__sub"><%= @group.name %>（メンバー<%= @notice.recipients.count %>人にメールで届きます）</p>

    <%= form_with model: @notice, url: group_notices_path(@group), class: "c-form" do |f| %>
      <%= render "shared/errors", model: @notice %>

      <div class="c-form__field">
        <%= f.label :title, class: "c-form__label" %>
        <%= f.text_field :title, placeholder: "例：次回のオフ会について", class: "c-form__input" %>
      </div>

      <div class="c-form__field">
        <%= f.label :body, class: "c-form__label" %>
        <%= f.text_area :body, rows: 8, class: "c-form__input c-form__textarea" %>
        <p class="c-form__hint">1000文字まで</p>
      </div>

      <%= f.submit "送信する", class: "c-button c-button--primary c-button--block",
            data: { turbo_confirm: "メンバー全員にメールで送信します。よろしいですか？" } %>
    <% end %>

    <p class="p-form-page__note"><%= link_to "← グループに戻る", group_path(@group) %></p>
  </div>
</section>
