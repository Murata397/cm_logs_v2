<%= form_with model: group, class: "c-form" do |f| %>
  <%= render "shared/errors", model: group %>

  <div class="c-form__field">
    <%= f.label :name, class: "c-form__label" %>
    <%= f.text_field :name, placeholder: "例：プリウス乗りの整備部", class: "c-form__input" %>
  </div>

  <div class="c-form__field">
    <%= f.label :theme, class: "c-form__label" %>
    <%= f.text_field :theme, placeholder: "例：プリウス、DIY初心者、洗車", class: "c-form__input" %>
    <p class="c-form__hint">一覧でバッジとして表示されます（任意）</p>
  </div>

  <div class="c-form__field">
    <%= f.label :introduction, class: "c-form__label" %>
    <%= f.text_area :introduction, rows: 3, placeholder: "どんな人に来てほしいか、どんな話をするか", class: "c-form__input c-form__textarea" %>
    <p class="c-form__hint">200文字まで</p>
  </div>

  <div class="c-form__field">
    <%= f.label :rules, class: "c-form__label" %>
    <%= f.text_area :rules, rows: 3, placeholder: "例：作業は安全第一で。部品の売買はしない。", class: "c-form__input c-form__textarea" %>
    <p class="c-form__hint">500文字まで（任意）</p>
  </div>

  <div class="c-form__field">
    <%= f.label :image, class: "c-form__label" %>
    <%= f.file_field :image, accept: "image/jpeg,image/png,image/webp,image/gif", class: "c-form__file" %>
  </div>

  <%= f.submit class: "c-button c-button--primary c-button--block" %>
<% end %>
