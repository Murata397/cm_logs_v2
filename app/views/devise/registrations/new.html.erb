<% content_for :title, "新規登録 | CM Logs" %>

<section class="p-auth">
  <div class="p-auth__card">
    <h1 class="p-auth__title">新規登録</h1>

    <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), class: "c-form" do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="c-form__field">
        <%= f.label :name, class: "c-form__label" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "nickname", class: "c-form__input" %>
      </div>

      <div class="c-form__field">
        <%= f.label :email, class: "c-form__label" %>
        <%= f.email_field :email, autocomplete: "email", class: "c-form__input" %>
      </div>

      <div class="c-form__field">
        <%= f.label :password, class: "c-form__label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "c-form__input" %>
        <% if @minimum_password_length %>
          <p class="c-form__hint"><%= @minimum_password_length %>文字以上で入力してください</p>
        <% end %>
      </div>

      <div class="c-form__field">
        <%= f.label :password_confirmation, class: "c-form__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "c-form__input" %>
      </div>

      <%= f.submit "登録する", class: "c-button c-button--primary c-button--block" %>
    <% end %>

    <p class="p-auth__link">
      すでにアカウントをお持ちの方は <%= link_to "ログイン", new_session_path(resource_name) %>
    </p>
  </div>
</section>