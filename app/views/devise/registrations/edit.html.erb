<% content_for :title, "アカウント設定 | CM Logs" %>

<section class="p-form-page">
  <div class="p-form-page__card">
    <h1 class="p-form-page__title">アカウント設定</h1>

    <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), method: :put, class: "c-form" do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="c-form__field">
        <%= f.label :email, class: "c-form__label" %>
        <%= f.email_field :email, autocomplete: "email", class: "c-form__input" %>
      </div>

      <div class="c-form__field">
        <%= f.label :password, "新しいパスワード", class: "c-form__label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "c-form__input" %>
        <p class="c-form__hint">変更しない場合は空のままにしてください</p>
      </div>

      <div class="c-form__field">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "c-form__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "c-form__input" %>
      </div>

      <div class="c-form__field">
        <%= f.label :current_password, "現在のパスワード", class: "c-form__label" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "c-form__input" %>
        <p class="c-form__hint">変更を保存するには、今のパスワードが必要です</p>
      </div>

      <%= f.submit "変更を保存する", class: "c-button c-button--primary c-button--block" %>
    <% end %>

    <div class="p-form-page__danger">
      <h2 class="p-form-page__danger-title">退会する</h2>
      <p>退会すると、投稿した整備記録・マイカー・コメントもすべて削除されます。</p>
      <%= button_to "退会する", registration_path(resource_name), method: :delete,
            class: "c-button c-button--outline",
            form: { data: { turbo_confirm: "本当に退会しますか？この操作は取り消せません。" } } %>
    </div>
  </div>
</section>
